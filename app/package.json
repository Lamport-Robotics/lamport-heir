{
  "name": "lamport-heir-app",
  "private": true,
  "version": "0.1.0",
  "description": "Lamport Heir in the browser: the vault page and the cold signer built for Heir-enabled vaults, with the claim program's knowledge added, and the page heirs use.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node build.mjs",
    "e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@solana/web3.js": "^1.98.0",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/base": "^1.1.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "1.56.1",
    "typescript": "^5.9.0",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
